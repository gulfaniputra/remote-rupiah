# EditorConfig: https://editorconfig.org
root = true

# Global defaults
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

# TypeScript & Deno files
[*.{ts,js,cjs,mjs,json,jsonc}]
indent_size = 2

# Elm files
[*.elm]
indent_size = 4

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Git commit messages (50/72 rulers)
[COMMIT_EDITMSG]
max_line_length = 72
indent_size = unset

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Makefiles
[Makefile]
indent_style = tab

# CSS
[*.{css,scss,sass}]
indent_size = 2

# HTML
[*.{html,htm}]
indent_size = 2

{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "options": {
            "provider": {
              "order": ["fireworks", "together"],
              "allow_fallbacks": true
            }
          }
        },
        "deepseek/deepseek-v4.1-flash": {
          "options": {
            "provider": {
              "order": ["deepseek", "fireworks", "together"],
              "allow_fallbacks": true
            }
          }
        }
      }
    }
  },

  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/.deno/**",
      "**/coverage/**",
      "**/.shadow-cljs/**",
      "**/elm-stuff/**",
      "**/*.log"
    ]
  },

  "permission": {
    "read": {
      "*.lock": "deny",
      "*package-lock.json": "deny",
      "*pnpm-lock.yaml": "deny",
      "*.min.js": "deny",
      "*.min.css": "deny",
      "*/elm.js": "deny"
    }
  },

  "agent": {
    "build": { "steps": 30 },
    "explore": { "model": "openrouter/deepseek/deepseek-v4.1-flash" }
  }
}

{
  "tasks": {
    "dev": "deno run --allow-env --allow-net --allow-read --unstable-cron --watch main.ts",
    "validate": "deno lint && deno test && cd frontend && elm make src/Main.elm --output=/dev/null"
  },
  "unstable": ["kv", "cron"],
  "test": {
    "exclude": ["frontend/"]
  },
  "lint": {
    "exclude": ["frontend/"]
  },
  "fmt": {
    "exclude": ["frontend/"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/csv": "jsr:@std/csv@1",
    "hono": "npm:hono@^4.4.0",
    "hono/middleware": "npm:hono@^4.4.0/cors",
    "zod": "npm:zod@^3.23.8",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.2.1",
    "postgres": "npm:postgres@^3.4.4"
  }
}

{
  "tasks": {
    "dev": "deno run --allow-env --allow-net --allow-read --unstable-kv --watch --env main.ts",
    "validate": "deno lint && deno test -A",
    "validate:frontend": "cd frontend && elm make src/Main.elm --output=/dev/null"
  },
  "test": {
    "exclude": ["frontend/"]
  },
  "lint": {
    "exclude": ["frontend/"]
  },
  "fmt": {
    "exclude": ["frontend/"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/csv": "jsr:@std/csv@1",
    "zod": "npm:zod@^3.23.8",
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.2.1",
    "postgres": "npm:postgres@^3.4.4",
    "hono": "npm:hono@4.4.0",
    "hono/jwt": "npm:hono@4.4.0/jwt",
    "hono/middleware": "npm:hono@4.4.0/middleware"
  }
}
